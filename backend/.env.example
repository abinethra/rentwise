# Gemini API Key from Google AI Studio (Keep your real .env file private and out of Git!)
GEMINI_API_KEY="your_gemini_api_key_here"

# Model name to use for Gemini vision and text extraction
GEMINI_MODEL="gemini-2.5-flash"

# Database URL: uses SQLite by default; to switch to PostgreSQL, simply change this to:
# postgresql://user:password@localhost:5432/rentwise
DATABASE_URL="sqlite:///./rentwise.db"

# Maximum file upload size in bytes (10 MB = 10 * 1024 * 1024)
MAX_FILE_SIZE_BYTES=10485760
